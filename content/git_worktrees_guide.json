      "headers": ["Command", "Description"],
      "rows": [
        ["git worktree add <path> <branch>", "Create worktree with existing branch"],
        ["git worktree add -b <new-branch> <path>", "Create worktree with new branch"],
        ["git worktree list", "View all active worktrees"],
        ["git worktree remove <path>", "Delete worktree directory"],
        ["git worktree prune", "Clean up stale worktree references"]
      ]
