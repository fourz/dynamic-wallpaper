    "title": "Model Context Protocol (MCP)",
    "description": "MCP extends Claude Code with external service integrations, enabling access to databases, APIs, and third-party tools.",
    "list": [
      "Standardized protocol for AI-tool communication",
      "Runs as local servers that Claude Code connects to",
      "Provides tools and resources from external services",
      "Configurable per-project or globally"
    ]
