  {
    "title": "Installation Examples",
    "code": [
      "# Add GitHub MCP server",
      "claude mcp add github npx @anthropic/mcp-github",
      "",
      "# Add Postgres database access",
      "claude mcp add postgres npx @anthropic/mcp-postgres",
      "",
      "# Add with environment variables",
      "claude mcp add notion npx @anthropic/mcp-notion \\",
      "  --env NOTION_API_KEY=secret_xxx"
    ]
  },
  {
    "title": "Security Considerations",
    "table": {
      "headers": ["Rule", "Details"],
      "rows": [
        ["No wildcards", "Use full tool names like mcp__github__get_issue"],
        ["Review permissions", "Each MCP server declares its tool capabilities"],
        ["Environment variables", "Store secrets in env, not in config files"],
        ["Scope access", "Grant minimum necessary permissions"]
      ]
    }
  },
  {
    "title": "Tool Permission Format",
    "description": "MCP tools follow a naming convention:",
    "code": [
      "# Format: mcp__<server>__<tool>",
      "",
      "# Examples:",
      "mcp__github__get_issue",
      "mcp__github__create_pull_request",
      "mcp__postgres__query",
      "mcp__notion__search"
    ]
  },
