  {
    "title": "Plugin Architecture",
    "table": {
      "headers": ["Component", "Responsibility", "Key Classes"],
      "rows": [
        ["Core System", "Plugin initialization and coordination", "RVNKWorlds, ConfigManager"],
        ["World Management", "World operations and state tracking", "WorldManager, RVNKWorld"],
        ["Group System", "World group organization", "WorldGroupManager, WorldGroup"],
        ["Player System", "Player data and position tracking", "PlayerManager, TeleportManager"],
        ["Inventory System", "Per-world inventory handling", "InventoryManager, InventoryData"],
        ["Portal System", "Custom portal emulation", "PortalManager, PortalType"],
        ["Template System", "World template processing", "TemplateManager, WorldTemplate"],
        ["Activity Tracking", "World usage monitoring", "ActivityTracker, CleanupManager"]
      ]
    },
    "description": "The RVNKWorlds plugin uses a modular architecture organized around specialized managers that handle different aspects of world management. This separation of concerns improves maintainability and extensibility."
  },
  {
    "title": "Core Components",
    "table": {
      "headers": ["Class", "Purpose", "Key Methods"],
      "rows": [
        ["RVNKWorlds", "Main plugin class, entry point to API", "getInstance(), getWorldManager(), reload()"],
        ["WorldManager", "Central world operations facade", "loadWorld(), unloadWorld(), teleportPlayer()"],
        ["ConfigManager", "Configuration handling", "loadConfig(), saveConfig(), get(), set()"],
        ["CommandHandler", "Command processing", "registerCommands(), handleCommand()"],
        ["EventListener", "Event subscription", "registerListeners()"]
      ]
    },
    "description": "These core components form the foundation of the plugin, handling initialization, configuration, and top-level operations."
  },
  {
    "title": "World Management System",
    "table": {
      "headers": ["Class", "Purpose", "Key Methods"],
      "rows": [
        ["WorldManager", "World operation facade", "loadWorld(), importWorld(), teleportPlayer()"],
        ["RVNKWorld", "World container and data access", "getName(), isLoaded(), getWorldGroup()"],
        ["WorldInfo", "World information container", "getEnvironment(), getPlayerCount(), getCreationTime()"],
        ["WorldCreationSettings", "World generation parameters", "getEnvironment(), getWorldType(), getSeed()"],
        ["WorldStateManager", "Persistence of world state", "saveWorldState(), loadWorldState()"]
      ]
    },
    "description": "The world management system is responsible for all operations related to worlds, including creation, loading, and accessing world information."
  },
  {
    "title": "World Group System",
    "table": {
      "headers": ["Class", "Purpose", "Key Methods"],
      "rows": [
        ["WorldGroupManager", "Group registration and lookup", "createGroup(), getGroup(), getAllGroups()"],
        ["WorldGroup", "Group data container", "addWorld(), removeWorld(), isInGroup()"],
        ["GroupRegistry", "Group state persistence", "saveGroups(), loadGroups()"],
        ["DimensionLinker", "Dimension association", "linkWorlds(), getLinkedWorld()"]
      ]
    },
    "description": "World groups allow related worlds to share settings and inventories. This system manages the relationships between worlds and groups."
  },
  {
    "title": "Player Management System",
    "table": {
      "headers": ["Class", "Purpose", "Key Methods"],
      "rows": [
        ["PlayerManager", "Player data handling", "getPlayerData(), savePlayerData()"],
        ["TeleportManager", "Player movement coordination", "teleport(), recordPosition(), recallPosition()"],
        ["PositionTracker", "Location memory", "storePosition(), retrievePosition()"],
        ["PlayerStateManager", "Player state persistence", "savePlayerState(), loadPlayerState()"]
      ]
    },
    "description": "The player management system handles player-related functionality, including teleportation, position tracking, and other player state data."
  },
  {
    "title": "Inventory Management System",
    "table": {
      "headers": ["Class", "Purpose", "Key Methods"],
      "rows": [
        ["InventoryManager", "Inventory operations", "saveInventory(), loadInventory(), clearInventory()"],
        ["InventoryData", "Inventory state container", "getItems(), getArmor(), getOffHand()"],
        ["GameModeInventory", "Per-gamemode inventories", "loadInventoryForGameMode(), saveInventoryForGameMode()"],
        ["InventoryStorage", "Data persistence", "getPlayerDataFile(), serializeInventory()"]
      ]
    },
    "description": "The inventory management system handles storing and loading player inventories based on world groups and game modes."
  },
  {
    "title": "Portal System",
    "table": {
      "headers": ["Class", "Purpose", "Key Methods"],
      "rows": [
        ["PortalManager", "Portal handling coordination", "handlePortalEvent(), getDestination()"],
        ["PortalType", "Portal type enumeration", "NETHER, END"],
        ["NetherPortalHandler", "Nether portal emulation", "findOrCreateDestinationPortal(), calculateDestinationCoordinates()"],
        ["EndPortalHandler", "End portal emulation", "handleEndPortalUse(), findEndExit()"]
      ]
    },
    "description": "The portal system emulates vanilla Minecraft portal behavior for custom world groups, ensuring players can use nether and end portals naturally."
  },
  {
    "title": "Template System",
    "table": {
      "headers": ["Class", "Purpose", "Key Methods"],
      "rows": [
        ["TemplateManager", "Template registration", "registerTemplate(), getTemplate()"],
        ["WorldTemplate", "Template data container", "applyTo(), getSettings()"],
        ["TemplateRegistry", "Template persistence", "saveTemplates(), loadTemplates()"],
        ["TemplateFactory", "Template creation", "createFromWorld(), createFromSettings()"]
      ]
    },
    "description": "The template system allows for easy world creation using predefined settings. Templates define world generation parameters and other settings."
  },
  {
    "title": "Activity Tracking System",
    "table": {
      "headers": ["Class", "Purpose", "Key Methods"],
      "rows": [
        ["ActivityTracker", "World usage monitoring", "recordActivity(), getLastActivity()"],
        ["CleanupManager", "Inactive world unloading", "checkInactiveWorlds(), scheduleCleanup()"],
        ["ActivityLogger", "Usage statistics", "logActivity(), generateReport()"],
        ["AutomatedTaskScheduler", "Scheduled operations", "scheduleTask(), cancelTask()"]
      ]
    },
    "description": "The activity tracking system monitors world usage and can automatically unload inactive worlds to improve server performance."
  },
